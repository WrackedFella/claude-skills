#!/usr/bin/env bash
# Read and update a project's GitHub Project board by field and option *names*, so
# skills never handle the opaque field/option IDs the API requires.
#
#   board set  <owner> <number> <issue-url> <Field>=<Option> [<Field>=<Option>...]
#   board get  <owner> <number> <issue-url>
#   board next <owner> <number>
#   board probe <owner> <number>
#
# Exit codes: 1 error, 3 empty queue (`next`), 4 issue not on the board (`get`),
# 5 project board unreachable (GraphQL/Projects access failed; any command).
#
# `probe` is a read-only reachability check: it prints `board: <owner>/<number> reachable`
# and one `<Field>: <opt1>, <opt2>, ...` line per single-select field, never changing the board.
#
# `set` adds the issue to the board if it is not on it yet; `get` is read-only and
# never changes the board. `get` lists at most 1000 items (the `item-list` cap); boards
# past that size need pagination. `next` prints the URL of
# the highest-priority open issue with Status=Ready and Agent-eligible=Yes that has no
# open blocking issues, or exits 3 if there is none.
set -euo pipefail

die() { echo "board: $*" >&2; exit 1; }
[[ $# -ge 3 ]] || die "usage: board set|get|next|probe <owner> <number> ..."
cmd=$1 owner=$2 number=$3
shift 3

# Stderr of every gh call lands here so a failure can be reported as exit 5.
errf=$(mktemp)
trap 'rm -f "$errf"' EXIT
unreachable() { echo "board: project board unreachable: $(head -n1 "$errf")" >&2; exit 5; }

# Projects belong to either a user or an org; the GraphQL root differs.
owner_kind=$(gh api "users/$owner" -q '.type | ascii_downcase' 2>"$errf") || unreachable
[[ $owner_kind == user || $owner_kind == organization ]] || die "unknown owner $owner"

project_json() {
  gh api graphql -f query="query(\$o:String!,\$n:Int!){ $owner_kind(login:\$o){ projectV2(number:\$n){
      id fields(first:50){ nodes{ ... on ProjectV2FieldCommon{ id name }
        ... on ProjectV2SingleSelectField{ options{ id name } } } } } } }" \
    -f o="$owner" -F n="$number" -q ".data.$owner_kind.projectV2"
}

# Prints the item ID for an issue, adding it to the board when absent.
item_id() {
  gh project item-add "$number" --owner "$owner" --url "$1" --format json -q .id
}

# Prints the item ID for an issue already on the board; read-only. Empty when absent.
find_item_id() {
  local items
  items=$(gh project item-list "$number" --owner "$owner" --format json -L 1000 2>"$errf") || unreachable
  jq -r --arg u "$1" 'first(.items[] | select(.content.url == $u) | .id) // empty' <<<"$items"
}

field_values() {
  local out
  out=$(gh api graphql -f query='query($id:ID!){ node(id:$id){ ... on ProjectV2Item{
      fieldValues(first:50){ nodes{ ... on ProjectV2ItemFieldSingleSelectValue{
        name field{ ... on ProjectV2FieldCommon{ name } } } } } } } }' \
    -f id="$1" -q '.data.node.fieldValues.nodes[] | select(.field) | "\(.field.name)=\(.name)"' 2>"$errf") || unreachable
  [[ -z $out ]] || echo "$out"
}

case $cmd in
  set)
    [[ $# -ge 2 ]] || die "usage: board set <owner> <number> <issue-url> <Field>=<Option>..."
    url=$1; shift
    proj=$(project_json 2>"$errf") || unreachable
    pid=$(jq -r .id <<<"$proj")
    iid=$(item_id "$url" 2>"$errf") || unreachable
    for pair in "$@"; do
      field=${pair%%=*} option=${pair#*=}
      [[ $pair == *=* && -n $field && -n $option ]] || die "expected Field=Option, got '$pair'"
      fid=$(jq -r --arg f "$field" '.fields.nodes[] | select(.name==$f) | .id' <<<"$proj")
      [[ -n $fid ]] || die "no field '$field' on board $owner/$number"
      oid=$(jq -r --arg f "$field" --arg o "$option" \
        '.fields.nodes[] | select(.name==$f) | .options[]? | select(.name==$o) | .id' <<<"$proj")
      [[ -n $oid ]] || die "field '$field' has no option '$option'"
      gh project item-edit --project-id "$pid" --id "$iid" --field-id "$fid" \
        --single-select-option-id "$oid" >/dev/null 2>"$errf" || unreachable
    done
    field_values "$iid"
    ;;
  get)
    [[ $# -eq 1 ]] || die "usage: board get <owner> <number> <issue-url>"
    iid=$(find_item_id "$1")
    [[ -n $iid ]] || { echo "board: $1 is not on board $owner/$number" >&2; exit 4; }
    field_values "$iid"
    ;;
  next)
    # Pages through every item; a partial read could skip the true top of the queue.
    # Captured before filtering so a failed query is exit 5, not an empty queue.
    pages=$(gh api graphql --paginate -f query="query(\$o:String!,\$n:Int!,\$endCursor:String){
        $owner_kind(login:\$o){ projectV2(number:\$n){ items(first:100, after:\$endCursor){
          pageInfo{ hasNextPage endCursor }
          nodes{ content{ ... on Issue{ url state
              blockedBy(first:50){ nodes{ state } } } }
            fieldValues(first:50){ nodes{ ... on ProjectV2ItemFieldSingleSelectValue{
              name field{ ... on ProjectV2FieldCommon{ name } } } } } } } } } }" \
      -f o="$owner" -F n="$number" \
      -q ".data.$owner_kind.projectV2.items.nodes[]" 2>"$errf") || unreachable
    jq -rs '
      map(
        (.fieldValues.nodes | map(select(.field) | {(.field.name): .name}) | add // {}) as $f
        | select(.content.url and .content.state == "OPEN")
        | select($f.Status == "Ready" and $f["Agent-eligible"] == "Yes")
        | select(all(.content.blockedBy.nodes[]; .state != "OPEN"))
        | {url: .content.url, pri: ($f.Priority // "P9")})
      | sort_by(.pri) | first | .url // empty' <<<"$pages" |
    { read -r url && echo "$url"; } || exit 3
    ;;
  probe)
    [[ $# -eq 0 ]] || die "usage: board probe <owner> <number>"
    proj=$(project_json 2>"$errf") || unreachable
    [[ -n $proj && $proj != null ]] || { echo "board: project board unreachable: no project $owner/$number" >&2; exit 5; }
    echo "board: $owner/$number reachable"
    jq -r '.fields.nodes[] | select(.options) | "\(.name): \([.options[].name] | join(", "))"' <<<"$proj"
    ;;
  *) die "unknown command '$cmd'" ;;
esac

#!/usr/bin/env bash
# Rejects changes that weaken a work item's acceptance (end-to-end) tests.
#
#   e2e-guard --base <sha> --since <sha> [--allow <sha>]... <glob>...
#
#   --base   the base branch commit the work branched from
#   --since  the step 2 test commit that wrote the acceptance tests
#   --allow  a later commit whose acceptance-test changes are permitted (a test-writer
#            commit from a challenge, mutant or acceptance-review round); repeatable
#   <glob>   the project's acceptance test paths, its runner config included; `*` and
#            `**` match across directories
#
# Fails when:
#   1. a file matching a glob changed after --since, in a commit not listed by --allow
#      or in the uncommitted working tree;
#   2. any line added to a matching file since --base calls test.only, test.skip,
#      test.fixme (or the describe forms) or test.slow.
#
# Exit codes: 0 clean, 1 violation (each printed as file and reason), 2 usage error.
set -euo pipefail

usage() { echo "e2e-guard: $*" >&2; exit 2; }

base="" since="" allow=() globs=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --base) base=${2:?}; shift 2 ;;
    --since) since=${2:?}; shift 2 ;;
    --allow) allow+=("$(git rev-parse --verify "${2:?}^{commit}")"); shift 2 ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    -*) usage "unknown option $1" ;;
    *) globs+=("$1"); shift ;;
  esac
done
[[ -n $base && -n $since && ${#globs[@]} -gt 0 ]] || usage "need --base, --since and at least one glob"
base=$(git rev-parse --verify "$base^{commit}") || usage "bad --base"
since=$(git rev-parse --verify "$since^{commit}") || usage "bad --since"

matches() {
  local f=$1 g
  for g in "${globs[@]}"; do
    # In [[ == ]], `*` already matches `/`; `**` is the same pattern.
    # shellcheck disable=SC2053
    [[ $f == ${g//\*\*/*} ]] && return 0
  done
  return 1
}

allowed() {
  local c=$1 a
  for a in "${allow[@]}"; do [[ $c == "$a" ]] && return 0; done
  return 1
}

violations=0
report() { echo "$1: $2"; violations=$((violations + 1)); }

while read -r commit; do
  allowed "$commit" && continue
  while read -r f; do
    [[ -n $f ]] && matches "$f" && report "$f" "changed in ${commit:0:12}, which is not an allowed test commit"
  done < <(git diff-tree --no-commit-id --name-only -r "$commit")
done < <(git rev-list "$since..HEAD")

while read -r f; do
  [[ -n $f ]] && matches "$f" && report "$f" "changed in the uncommitted working tree"
done < <(git diff --name-only HEAD; git ls-files --others --exclude-standard)

marker='(test|describe)(\.describe)?\.(only|skip|fixme|slow)[[:space:]]*\('
file=""
while IFS= read -r line; do
  case $line in
    "+++ b/"*) file=${line#+++ b/} ;;
    "+++ "*) file="" ;;
    "+"*)
      if [[ -n $file ]] && matches "$file" && [[ ${line:1} =~ $marker ]]; then
        report "$file" "adds ${BASH_REMATCH[0]%(*}"
      fi ;;
  esac
done < <(git diff "$base" --unified=0 --no-color)

if (( violations > 0 )); then
  echo "e2e-guard: $violations violation(s)" >&2
  exit 1
fi

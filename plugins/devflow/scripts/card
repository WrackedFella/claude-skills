#!/usr/bin/env bash
# File one work-item card as a GitHub issue, link it as a sub-issue of its feature
# issue, and optionally set board fields, so skills never hand-write the sub-issue API calls.
#
#   card publish <feature-issue-number> <title> <body-file> [--label <name>]...
#                [--board <owner> <number> <Field>=<Option>...]
#   card link    <issue-number> <blocker-number>
#
# `publish` prints exactly one line on success: `#<n> <url>`.
# `link` marks <issue> as blocked by <blocker> (the REST issue-dependency API, which
# needs the blocker's numeric id, not its number) and uses REST only; linking twice is
# not an error. The repository is GH_REPO, else the origin remote.
# Exit codes: 1 error (including a filed-but-unlinked issue), 5 project board unreachable
# (the issue is filed and linked; only the board fields were not set).
set -euo pipefail

die() { echo "card: $*" >&2; exit 1; }
# owner/name from GH_REPO or the origin remote; `gh repo view` is GraphQL, which cloud
# threads cannot reach.
repo_slug() {
  [[ -z ${GH_REPO:-} ]] || { echo "$GH_REPO"; return; }
  local url
  url=$(git remote get-url origin) || die "no origin remote; set GH_REPO=<owner>/<name>"
  url=${url%.git}
  [[ $url =~ ([^/:]+/[^/:]+)$ ]] || die "cannot read owner/name from '$url'; set GH_REPO"
  echo "${BASH_REMATCH[1]}"
}
usage() { die "usage: card link <issue-number> <blocker-number> | card publish <feature-issue-number> <title> <body-file> [--label <name>]... [--board <owner> <number> <Field>=<Option>...]"; }

if [[ ${1:-} == link ]]; then
  [[ $# -eq 3 ]] || usage
  issue=$2 blocker=$3
  [[ $issue =~ ^[0-9]+$ && $blocker =~ ^[0-9]+$ ]] || die "issue and blocker must be numbers, got '$issue' '$blocker'"
  [[ $issue != "$blocker" ]] || die "#$issue cannot block itself"
  repo=$(repo_slug)
  bid=$(gh api "repos/$repo/issues/$blocker" --jq .id)
  errf=$(mktemp)
  trap 'rm -f "$errf"' EXIT
  if ! gh api -X POST "repos/$repo/issues/$issue/dependencies/blocked_by" -F issue_id="$bid" >/dev/null 2>"$errf"; then
    grep -qi "already" "$errf" || die "could not link #$issue as blocked by #$blocker: $(cat "$errf")"
  fi
  echo "#$issue blocked by #$blocker"
  exit 0
fi
[[ ${1:-} == publish ]] || usage
shift
[[ $# -ge 3 ]] || usage
feature=$1 title=$2 body=$3
shift 3
[[ $feature =~ ^[0-9]+$ ]] || die "feature issue must be a number, got '$feature'"
[[ -f $body ]] || die "body file not found: $body"

labels=() board_args=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --label)
      [[ $# -ge 2 ]] || usage
      labels+=(--label "$2"); shift 2 ;;
    --board)
      [[ $# -ge 4 ]] || usage
      board_args=("$2" "$3"); shift 3
      while [[ $# -gt 0 && $1 != --* ]]; do board_args+=("$1"); shift; done
      [[ ${#board_args[@]} -ge 3 ]] || usage
      for pair in "${board_args[@]:2}"; do
        [[ $pair == *=* ]] || die "expected Field=Option, got '$pair'"
      done ;;
    *) usage ;;
  esac
done

repo=$(repo_slug)
url=$(gh issue create --title "$title" --body-file "$body" ${labels[@]+"${labels[@]}"})
n=${url##*/}
[[ $n =~ ^[0-9]+$ ]] || die "could not parse issue number from '$url'"
id=$(gh api "repos/$repo/issues/$n" --jq .id)

errf=$(mktemp)
trap 'rm -f "$errf"' EXIT
if ! gh api "repos/$repo/issues/$feature/sub_issues" -F sub_issue_id="$id" >/dev/null 2>"$errf"; then
  echo "$url"
  die "filed #$n but could not link it under #$feature: $(cat "$errf")"
fi

if [[ ${#board_args[@]} -gt 0 ]]; then
  rc=0
  "$(dirname "$0")/board" set "${board_args[0]}" "${board_args[1]}" "$url" "${board_args[@]:2}" >/dev/null || rc=$?
  if [[ $rc -eq 5 ]]; then
    echo "card: filed and linked #$n; board unreachable, fields not set" >&2
    exit 5
  fi
  [[ $rc -eq 0 ]] || exit "$rc"
fi

echo "#$n $url"

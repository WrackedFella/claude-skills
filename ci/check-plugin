#!/usr/bin/env python3
"""Validates the marketplace, its plugins, and every path and name their files refer to.

    ci/check-plugin [<repo-root>]

Checks:
  - .claude-plugin/marketplace.json and each plugin's .claude-plugin/plugin.json parse,
    carry the required fields, and agree on the plugin name; no `version` is set
    (a merge to main is the release);
  - hooks/hooks.json parses and every hook command it names exists and is executable;
  - every agent and skill has YAML frontmatter with known keys, a name matching its
    file or directory, a description, a valid model, known tools and existing skills;
  - every agent is named in README.md and wiki/agents.md at the repository root;
  - every file under scripts/ is executable and starts with a shebang;
  - every ${CLAUDE_PLUGIN_ROOT}/... and ${CLAUDE_SKILL_DIR}/... path exists;
  - every `<plugin>:<name>` reference names an agent or skill of that plugin.

Prints one line per problem as `<file>: <problem>`. Exit 0 clean, 1 problems, 2 usage.
"""

import json
import os
import re
import sys

import yaml

AGENT_KEYS = {
    "name", "description", "tools", "disallowedTools", "model", "permissionMode",
    "skills", "hooks", "maxTurns", "color", "mcpServers", "memory", "background",
    "effort", "isolation", "initialPrompt",
}
SKILL_KEYS = {
    "name", "description", "argument-hint", "arguments", "allowed-tools",
    "disable-model-invocation", "user-invocable", "model", "effort", "context",
    "agent", "hooks", "background", "paths", "shell",
}
TOOLS = {
    "Agent", "Task", "Bash", "BashOutput", "KillShell", "Edit", "MultiEdit", "Write",
    "Read", "Glob", "Grep", "LS", "NotebookEdit", "NotebookRead", "WebFetch",
    "WebSearch", "TodoWrite", "Skill", "SendMessage", "ToolSearch", "Monitor",
}
MODEL = re.compile(r"^(inherit|opus|sonnet|haiku|claude-[a-z0-9.-]+(\[1m\])?)$")
NAME = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
# A path ends before a character that can't be in one, or a sentence's closing period.
ROOT_REF = re.compile(r"\$\{CLAUDE_PLUGIN_ROOT\}/([A-Za-z0-9_./-]*[A-Za-z0-9_/-]|)")
SKILL_REF = re.compile(r"\$\{CLAUDE_SKILL_DIR\}/([A-Za-z0-9_./-]*[A-Za-z0-9_/-]|)")

# Docs that must name every agent, relative to the repository root.
AGENT_DOCS = ("README.md", "wiki/agents.md")

problems = []


def problem(path, msg):
    problems.append(f"{path}: {msg}")


def rel(path):
    return os.path.relpath(path, ROOT)


def load_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        problem(rel(path), "missing")
    except json.JSONDecodeError as e:
        problem(rel(path), f"invalid JSON: {e}")
    return None


def frontmatter(path):
    with open(path, encoding="utf-8") as f:
        text = f.read()
    m = re.match(r"^---\n(.*?)\n---\n", text, re.S)
    if not m:
        problem(rel(path), "no YAML frontmatter")
        return None
    try:
        data = yaml.safe_load(m.group(1))
    except yaml.YAMLError as e:
        problem(rel(path), f"frontmatter is not valid YAML: {e}".replace("\n", " "))
        return None
    if not isinstance(data, dict):
        problem(rel(path), "frontmatter is not a mapping")
        return None
    return data


def read_text(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return ""


def as_list(value):
    if value is None:
        return []
    if isinstance(value, list):
        return [str(v).strip() for v in value]
    return [v.strip() for v in str(value).split(",") if v.strip()]


def check_common(path, data, keys, expected_name):
    for key in sorted(set(data) - keys):
        problem(rel(path), f"unknown frontmatter key '{key}'")
    if data.get("name") != expected_name:
        problem(rel(path), f"name '{data.get('name')}' does not match '{expected_name}'")
    desc = data.get("description")
    if not isinstance(desc, str) or not desc.strip():
        problem(rel(path), "description is missing or empty")
    elif len(desc) > 1024:
        problem(rel(path), f"description is {len(desc)} characters, over 1024")
    if "model" in data and not MODEL.match(str(data["model"])):
        problem(rel(path), f"model '{data['model']}' is not an alias, a claude-* ID or inherit")


def check_tools(path, value, key):
    for tool in as_list(value):
        base = tool.split("(", 1)[0]
        if base not in TOOLS and not base.startswith("mcp__"):
            problem(rel(path), f"{key} names unknown tool '{tool}'")


def check_plugin(pdir, pname):
    manifest = load_json(os.path.join(pdir, ".claude-plugin", "plugin.json"))
    if manifest is not None:
        if manifest.get("name") != pname:
            problem(rel(os.path.join(pdir, ".claude-plugin", "plugin.json")),
                    f"name '{manifest.get('name')}' does not match marketplace entry '{pname}'")
        if "version" in manifest:
            problem(rel(os.path.join(pdir, ".claude-plugin", "plugin.json")),
                    "sets version, which pins consumers to a cached copy")

    skills_dir = os.path.join(pdir, "skills")
    agents_dir = os.path.join(pdir, "agents")
    skills = sorted(d for d in os.listdir(skills_dir)) if os.path.isdir(skills_dir) else []
    agents = sorted(f[:-3] for f in os.listdir(agents_dir) if f.endswith(".md")) \
        if os.path.isdir(agents_dir) else []

    for s in skills:
        path = os.path.join(skills_dir, s, "SKILL.md")
        if not os.path.isfile(path):
            problem(rel(os.path.join(skills_dir, s)), "skill directory has no SKILL.md")
            continue
        data = frontmatter(path)
        if data is not None:
            check_common(path, data, SKILL_KEYS, s)
            check_tools(path, data.get("allowed-tools"), "allowed-tools")

    for a in agents:
        path = os.path.join(agents_dir, a + ".md")
        data = frontmatter(path)
        if data is None:
            continue
        check_common(path, data, AGENT_KEYS, a)
        check_tools(path, data.get("tools"), "tools")
        check_tools(path, data.get("disallowedTools"), "disallowedTools")
        for skill in as_list(data.get("skills")):
            if skill.split(":")[-1] not in skills:
                problem(rel(path), f"skills names '{skill}', which is not a skill of {pname}")

    for doc in AGENT_DOCS:
        text = read_text(os.path.join(ROOT, doc))
        for a in agents:
            if not re.search(r"(?<![\w-])" + re.escape(a) + r"(?![\w-])", text):
                problem(rel(os.path.join(agents_dir, a + ".md")), f"agent is not named in {doc}")

    hooks_path = os.path.join(pdir, "hooks", "hooks.json")
    if os.path.exists(hooks_path):
        hooks = load_json(hooks_path)
        commands = []
        for groups in (hooks or {}).get("hooks", {}).values():
            for group in groups:
                commands += [h.get("command", "") for h in group.get("hooks", [])
                             if h.get("type") == "command"]
        for cmd in commands:
            m = ROOT_REF.match(cmd)
            if not m:
                continue
            target = os.path.join(pdir, m.group(1))
            if not os.access(target, os.X_OK):
                problem(rel(hooks_path), f"hook command ${{CLAUDE_PLUGIN_ROOT}}/{m.group(1)} "
                                         "is missing or not executable")

    scripts_dir = os.path.join(pdir, "scripts")
    if os.path.isdir(scripts_dir):
        for name in sorted(os.listdir(scripts_dir)):
            path = os.path.join(scripts_dir, name)
            if not os.path.isfile(path):
                continue
            if not os.access(path, os.X_OK):
                problem(rel(path), "not executable")
            with open(path, "rb") as f:
                if f.read(2) != b"#!":
                    problem(rel(path), "no shebang")

    names = set(skills) | set(agents)
    name_ref = re.compile(r"(?<![\w/@-])" + re.escape(pname) + r":([a-z][a-z0-9-]*)")
    for dirpath, _, files in os.walk(pdir):
        for fname in files:
            path = os.path.join(dirpath, fname)
            try:
                with open(path, encoding="utf-8") as f:
                    text = f.read()
            except UnicodeDecodeError:
                continue
            for ref in sorted(set(ROOT_REF.findall(text))):
                if not os.path.exists(os.path.join(pdir, ref)):
                    problem(rel(path), f"${{CLAUDE_PLUGIN_ROOT}}/{ref} does not exist")
            skill_dir = skill_root(path, skills_dir)
            for ref in sorted(set(SKILL_REF.findall(text))):
                if skill_dir is None:
                    problem(rel(path), f"${{CLAUDE_SKILL_DIR}}/{ref} used outside a skill")
                elif not os.path.exists(os.path.normpath(os.path.join(skill_dir, ref))):
                    problem(rel(path), f"${{CLAUDE_SKILL_DIR}}/{ref} does not exist")
            for ref in sorted(set(name_ref.findall(text))):
                if ref not in names:
                    problem(rel(path), f"{pname}:{ref} is not an agent or skill of {pname}")


def skill_root(path, skills_dir):
    """The skill directory a file belongs to, or None outside skills/."""
    r = os.path.relpath(path, skills_dir)
    if r.startswith(".."):
        return None
    return os.path.join(skills_dir, r.split(os.sep)[0])


def main():
    market_path = os.path.join(ROOT, ".claude-plugin", "marketplace.json")
    market = load_json(market_path)
    if market is not None:
        for key in ("name", "owner", "plugins"):
            if key not in market:
                problem(rel(market_path), f"missing '{key}'")
        if not isinstance(market.get("owner"), dict) or not market["owner"].get("name"):
            problem(rel(market_path), "owner.name is missing")
        for entry in market.get("plugins", []):
            pname, source = entry.get("name"), entry.get("source")
            if not pname or not NAME.match(pname):
                problem(rel(market_path), f"plugin name '{pname}' is not kebab-case")
                continue
            if "version" in entry:
                problem(rel(market_path), f"plugin '{pname}' sets version, which pins consumers")
            if not isinstance(source, str) or not source.startswith("./"):
                problem(rel(market_path), f"plugin '{pname}' source is not a relative path")
                continue
            pdir = os.path.normpath(os.path.join(ROOT, source))
            if not os.path.isdir(pdir):
                problem(rel(market_path), f"plugin '{pname}' source {source} does not exist")
                continue
            check_plugin(pdir, pname)

    for p in problems:
        print(p)
    return 1 if problems else 0


if __name__ == "__main__":
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and sys.argv[1].startswith("-")):
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)
    ROOT = os.path.abspath(sys.argv[1] if len(sys.argv) == 2 else ".")
    sys.exit(main())
